# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or leaves empty to use built-in resilient JSON store)
MONGODB_URI=mongodb://localhost:27017/giftdrop

# JWT Authentication
JWT_SECRET=giftdrop_secret_jwt_key_2026_super_secure_random
JWT_EXPIRE=30d

# Cloudinary (Image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (India Payment Gateway)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere

# Google OAuth (Prepared structure)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP / Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=support@giftdrop.com
FROM_NAME="GiftDrop Team"
